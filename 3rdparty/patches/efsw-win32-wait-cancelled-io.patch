+			 WaitForSingleObject( pWatch->Watch->DirHandle, 5000 ) == WAIT_TIMEOUT &&
+			 !HasOverlappedIoCompleted( &pWatch->Overlapped ) ) {
+			CloseHandle( pWatch->Watch->DirHandle );
+			return;
+		}
 		CloseHandle( pWatch->Watch->DirHandle );
 		efSAFE_DELETE_ARRAY( pWatch->Watch->DirName );
 		efSAFE_DELETE( pWatch->Watch );
